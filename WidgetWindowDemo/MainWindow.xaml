<Window x:Class="WidgetWindowDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WidgetWindowDemo"
    xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
    Title="Widget Manager"
    Height="700"
    Width="1120"
    MinHeight="540"
    MinWidth="900"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource WindowBrush}"
    Foreground="{StaticResource TextBrush}"
    FontFamily="Segoe UI"
    AllowDrop="True"
    DragEnter="Window_DragEnter"
    DragOver="Window_DragOver"
    DragLeave="Window_DragLeave"
    Drop="Window_Drop"
    Icon="/Assets/favicon.ico">

    <Window.Resources>
        <local:ThumbnailConverter x:Key="ThumbnailConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Numeric field: Enter commits the value. -->
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <EventSetter Event="KeyDown" Handler="NumberBox_KeyDown" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!-- Card container: selection and hover live here so the whole card reacts. -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Width="236" Margin="0,0,14,14" CornerRadius="12"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small pill (type / status) -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="#CC13131B" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,16">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,26">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Widget Manager" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="Widgets multimedia" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Logs -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" Click="BtnOpenLogs_Click"
                        ToolTip="Abre la carpeta con el registro de la aplicación (errores y eventos de los últimos 14 días)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9F9;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Registros de la app" />
                    </StackPanel>
                </Button>

                <!-- Tip -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE82F;" FontSize="13"
                                       Foreground="{StaticResource AccentHoverBrush}" />
                            <TextBlock Text="Consejo" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Arrastra imágenes, GIF o vídeos a esta ventana para importarlos. Al cerrarla, los widgets siguen en el escritorio (icono en la bandeja)." />
                    </StackPanel>
                </Border>

                <!-- Navigation / filters -->
                <StackPanel>
                    <TextBlock Text="BIBLIOTECA" Style="{StaticResource SectionHeader}" Margin="4,0,0,8" />

                    <RadioButton x:Name="NavAll" Style="{StaticResource NavItem}" Tag="All" IsChecked="True" Checked="Nav_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A9;" FontSize="14" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="Todos los widgets" />
                            <TextBlock Grid.Column="2" x:Name="CountAll" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavAlwaysVisible" Style="{StaticResource NavItem}" Tag="AlwaysVisible" Checked="Nav_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE718;" FontSize="14" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="Siempre visible" />
                            <TextBlock Grid.Column="2" x:Name="CountAlwaysVisible" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavDesktop" Style="{StaticResource NavItem}" Tag="DesktopIntegrated" Checked="Nav_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="14" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="Integrado en el escritorio" TextTrimming="CharacterEllipsis"
                                       ToolTip="Integrado en el escritorio" />
                            <TextBlock Grid.Column="2" x:Name="CountDesktop" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavHidden" Style="{StaticResource NavItem}" Tag="Hidden" Checked="Nav_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xED1A;" FontSize="14" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="Ocultos" />
                            <TextBlock Grid.Column="2" x:Name="CountHidden" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Main area ================= -->
        <Grid Grid.Column="1" Margin="28,22,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="0,0,14,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ViewTitle" Text="Todos los widgets" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="ViewSubtitle" Margin="0,3,0,0" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="BtnImport_Click"
                        ToolTip="Importar imágenes, GIF o vídeos (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Importar archivos" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Widget cards -->
            <ListBox x:Name="ListWidgets"
                     Grid.Row="1"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{StaticResource TextBrush}"
                     ItemContainerStyle="{StaticResource CardItem}"
                     SelectionMode="Single"
                     SelectionChanged="ListWidgets_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyboardNavigation.TabNavigation="Continue">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- Preview (GIFs animate) -->
                            <Grid x:Name="Preview" Height="126" Margin="8,8,8,0">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,218,126" RadiusX="8" RadiusY="8" />
                                </Grid.Clip>
                                <Border Background="#0D0D14" />
                                <Image Stretch="Uniform"
                                       gif:ImageBehavior.AnimatedSource="{Binding FullPath, Converter={StaticResource ThumbnailConverter}}"
                                       gif:ImageBehavior.RepeatBehavior="Forever" />
                                <!-- Video placeholder -->
                                <Grid Visibility="Collapsed" x:Name="VideoPlaceholder">
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2A2550" Offset="0" />
                                                <GradientStop Color="#141420" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#33FFFFFF">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="18"
                                                   HorizontalAlignment="Center" Foreground="White" />
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#D8D8E8" />
                                </Border>
                                <Border x:Name="ErrorPill" Style="{StaticResource Pill}" HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom" Margin="8" Visibility="Collapsed"
                                        ToolTip="{Binding LoadError}">
                                    <TextBlock Text="ERROR AL CARGAR" FontSize="10" FontWeight="SemiBold" Foreground="#FF8A8E" />
                                </Border>
                                <Border x:Name="HiddenPill" Style="{StaticResource Pill}" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="8" Visibility="Collapsed">
                                    <TextBlock Text="OCULTO" FontSize="10" FontWeight="SemiBold" Foreground="#FFB86B" />
                                </Border>
                            </Grid>

                            <!-- Name + mode -->
                            <StackPanel Margin="14,10,14,0">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding LayerGlyph}" FontSize="11"
                                               Foreground="{StaticResource AccentHoverBrush}" />
                                    <TextBlock Text="{Binding LayerLabel}" FontSize="12" Margin="6,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Quick actions -->
                            <StackPanel Orientation="Horizontal" Margin="8,6,8,8">
                                <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsShown}"
                                              Content="{Binding VisibilityIcon}" ToolTip="Mostrar u ocultar en el escritorio" />
                                <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsPaused}"
                                              Content="{Binding PlaybackGlyph}" ToolTip="Reproducir o pausar"
                                              Visibility="{Binding IsPlayable, Converter={StaticResource BoolToVisibility}}" />
                                <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding Locked}"
                                              Content="{Binding LockIcon}" IsEnabled="{Binding IsAlwaysVisible}"
                                              ToolTip="Bloquear: no se puede mover y los clics lo atraviesan (solo «Siempre visible»)" />
                            </StackPanel>
                        </StackPanel>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="Video">
                                <Setter TargetName="VideoPlaceholder" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                                <Setter TargetName="ErrorPill" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Hidden}" Value="True">
                                <Setter TargetName="Preview" Property="Opacity" Value="0.45" />
                                <Setter TargetName="HiddenPill" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state: no widgets at all -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,0,14,60" Visibility="Collapsed">
                <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE91B;" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentHoverBrush}" />
                </Border>
                <TextBlock Text="Aún no tienes widgets" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,4" />
                <TextBlock Text="Importa una imagen, un GIF o un vídeo para mostrarlo en tu escritorio."
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <Button Style="{StaticResource PrimaryButton}" Click="BtnImport_Click" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Importar archivos" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Empty state: current filter has no results -->
            <StackPanel x:Name="EmptyFilterState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,0,14,60" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="28" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="No hay widgets en esta vista" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>

        <!-- ================= Details panel ================= -->
        <Border x:Name="DetailsPanel" Grid.Column="2" Width="330" Visibility="Collapsed"
                Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                DataContext="{Binding SelectedItem, ElementName=ListWidgets}">
            <DockPanel>
                <!-- Header -->
                <Grid DockPanel.Dock="Top" Margin="20,18,12,0">
                    <TextBlock Text="Configuración" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right"
                            ToolTip="Cerrar panel" Click="BtnCloseDetails_Click" />
                </Grid>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                    <Button Style="{StaticResource DangerButton}" Click="BtnDelete_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Eliminar widget" />
                        </StackPanel>
                    </Button>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14,20,20">
                    <StackPanel>
                        <!-- Preview -->
                        <Grid Height="164">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,290,164" RadiusX="10" RadiusY="10" />
                            </Grid.Clip>
                            <Border Background="#0D0D14" />
                            <Image x:Name="PreviewImage" Stretch="Uniform"
                                   gif:ImageBehavior.AnimatedSource="{Binding FullPath, Converter={StaticResource ThumbnailConverter}}"
                                   gif:ImageBehavior.RepeatBehavior="Forever" />
                            <MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Close"
                                          IsMuted="True" Stretch="Uniform" MediaEnded="PreviewVideo_MediaEnded" />
                        </Grid>

                        <TextBlock Margin="0,10,0,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="{Binding TypeLabel, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding FileName, Mode=OneWay}" />
                        </TextBlock>

                        <!-- Load error: identifies the file and what to do -->
                        <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource DangerSoftBrush}"
                                Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="No se puede mostrar este archivo" FontWeight="SemiBold" FontSize="12.5" Foreground="#FF8A8E" />
                                <TextBlock Text="{Binding LoadError}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="El original no se ha modificado. Elimina este widget y vuelve a importar el archivo, o conviértelo a un formato válido con un editor e importa la copia." />
                            </StackPanel>
                        </Border>

                        <!-- Name -->
                        <TextBlock Text="NOMBRE" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Display mode -->
                        <TextBlock Text="MODO DE VISUALIZACIÓN" Style="{StaticResource SectionHeader}" />
                        <RadioButton Style="{StaticResource ModeOption}" GroupName="DisplayMode"
                                     IsChecked="{Binding IsAlwaysVisible}" Content="Siempre visible"
                                     Tag="Por encima de las ventanas de las aplicaciones. Se puede mover directamente con el ratón." />
                        <RadioButton Style="{StaticResource ModeOption}" GroupName="DisplayMode" Margin="0,8,0,0"
                                     IsChecked="{Binding IsDesktopIntegrated}" Content="Integrado en el escritorio"
                                     Tag="Sobre el fondo de pantalla y detrás de todas las ventanas. Sigue visible al pulsar Win + D." />

                        <!-- Position and size -->
                        <TextBlock Text="POSICIÓN Y TAMAÑO" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="X" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumberBox}" Text="{Binding Left, StringFormat={}{0:0}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumberBox}" Text="{Binding Top, StringFormat={}{0:0}}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Ancho" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumberBox}" Text="{Binding Width, StringFormat={}{0:0}}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Alto" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumberBox}" Text="{Binding Height, StringFormat={}{0:0}}" />
                            </StackPanel>
                        </Grid>
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                Click="BtnEdit_Click" IsEnabled="{Binding IsShown}"
                                ToolTip="Muestra el widget por encima de todo con controles para moverlo y redimensionarlo">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C2;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Mover y redimensionar en pantalla" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Text" Value="Terminar edición" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Appearance -->
                        <TextBlock Text="APARIENCIA" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <TextBlock Text="Opacidad" FontSize="13" />
                            <TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                        <Slider Minimum="0.1" Maximum="1" SmallChange="0.05" LargeChange="0.1" Margin="0,6,0,0"
                                Value="{Binding Opacity}" />

                        <!-- Behaviour -->
                        <TextBlock Text="COMPORTAMIENTO" Style="{StaticResource SectionHeader}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsShown}">
                            <StackPanel>
                                <TextBlock Text="Visible en el escritorio" FontSize="13" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsPaused}" Margin="0,12,0,0"
                                  Visibility="{Binding IsPlayable, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Pausar reproducción" FontSize="13" />
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Locked}" Margin="0,12,0,0"
                                  IsEnabled="{Binding IsAlwaysVisible}">
                            <StackPanel>
                                <TextBlock Text="Bloqueado" FontSize="13" />
                                <TextBlock Text="No se puede mover y los clics lo atraviesan." FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>

                        <!-- Desktop-mode note -->
                        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource AccentSoftBrush}"
                                Visibility="{Binding IsDesktopIntegrated, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Los widgets integrados no reciben clics: los iconos que tengan debajo se pueden seguir usando con normalidad. Para colocarlos usa «Mover y redimensionar en pantalla» o los campos de posición." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= Drop overlay ================= -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="3" Background="#D913131B" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Margin="28" CornerRadius="16" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="34" HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentHoverBrush}" />
                    <TextBlock Text="Suelta los archivos para importarlos" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
